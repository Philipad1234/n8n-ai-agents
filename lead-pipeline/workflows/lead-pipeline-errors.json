      "name": "Error Trigger"
    },
    {
      "parameters": {
        "mode": "runOnceForEachItem",
        "jsCode": "// Runs when the main workflow crashes. Tells a person, and logs it.\n// The lead's data isn't lost: n8n keeps the failed execution, so it can be retried.\n\nconst ex = $json.execution ?? {};\nconst wf = $json.workflow ?? {};\nconst esc = (v) => String(v ?? \"\").replace(/&/g, \"&amp;\").replace(/</g, \"&lt;\").replace(/>/g, \"&gt;\");\n\nconst node = ex.lastNodeExecuted ?? \"unknown node\";\nconst message = ex.error?.message ?? \"unknown error\";\n\nconst text = [\n  \":rotating_light: *Lead pipeline crashed*\",\n  `Workflow: ${esc(wf.name)}`,\n  `Failed at: *${esc(node)}*`,\n  `Error: ${esc(message)}`,\n  ex.url ? `<${ex.url}|Open execution in n8n>` : `Execution ID: ${esc(ex.id)}`,\n  \"The lead's data is saved in this execution. Fix the cause, then retry it from the Executions list.\",\n].join(\"\\n\");\n\nreturn {\n  json: {\n    slack_message: { channel: \"C0CBRN9KKH8\", text, unfurl_links: false },\n    log_row: {\n      logged_at: new Date().toISOString(),\n      outcome: \"crashed\",\n      errors: `${node}: ${message} (execution ${ex.id ?? \"?\"})`,\n    },\n  },\n};"
      },
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        224,
        0
      ],
      "id": "39aeb8c0-6985-4b6f-aadb-08c69f1f7b6c",
